{
	"name": "unchained-x-dao",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "bun run search-index && react-router build",
		"search-index": "node scripts/build-search-index.mjs",
		"cf-typegen": "wrangler types",
		"deploy": "bun run build && wrangler deploy",
		"dev": "react-router dev",
		"postinstall": "bun run cf-typegen",
		"preview": "bun run build && vite preview",
		"typecheck": "bun run cf-typegen && react-router typegen && tsc -b",
		"lint": "biome check .",
		"lint:fix": "biome check --write .",
		"format": "biome format --write ."
	},
	"dependencies": {
		"@react-three/drei": "^10.7.8",
		"@react-three/fiber": "^9.7.0",
		"@sanity/client": "^7.27.0",
		"@sanity/image-url": "^2.1.1",
		"gsap": "^3.15.0",
		"isbot": "^5.2.2",
		"react": "^19.3.0",
		"react-dom": "^19.3.0",
		"react-router": "7.13.2",
		"remix-utils": "^9.3.1",
		"sanity": "^5.31.2",
		"styled-components": "^6.5.3",
		"three": "^0.186.0"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.5.13",
		"@cloudflare/vite-plugin": "^1.54.8",
		"@mdx-js/rollup": "^3.1.1",
		"@react-router/dev": "7.13.2",
		"@tailwindcss/vite": "^4.3.3",
		"@types/node": "^22.20.2",
		"@types/react": "^19.3.0",
		"@types/react-dom": "^19.3.0",
		"@types/three": "^0.186.0",
		"github-slugger": "^2.0.0",
		"gray-matter": "^4.0.3",
		"pagefind": "^1.5.2",
		"rehype-slug": "^6.0.0",
		"remark-frontmatter": "^5.0.0",
		"remark-mdx-frontmatter": "^5.2.0",
		"sharp": "^0.34.5",
		"tailwindcss": "^4.3.3",
		"typescript": "^5.9.3",
		"vite": "^7.3.6",
		"vite-tsconfig-paths": "^5.1.4",
		"wrangler": "^4.131.1"
	}
